;;; elfin-mpv-test.el --- mpv wire protocol and lifecycle -*- lexical-binding: t -*-

(require 'elfin-test-helper)

(ert-deftest elfin-mpv-command-options ()
  (let ((elfin-default-volume 37)
        (elfin-replaygain nil)
        (elfin-mpv-extra-options '("--audio-device=test")))
    (should (equal (car (elfin--mpv-command)) "mpv"))
    (should (member "--volume=37" (elfin--mpv-command)))
    (should (member "--audio-device=test" (elfin--mpv-command)))
    (should-not (seq-find (lambda (arg) (string-prefix-p "--replaygain=" arg))
                         (elfin--mpv-command)))
    (dolist (mode '(track album))
      (let ((elfin-replaygain mode))
        (should (member (format "--replaygain=%s" mode) (elfin--mpv-command)))))))

(ert-deftest elfin-mpv-commands-correlate-out-of-order-responses ()
  (let ((elfin--request-counter 1)
        (elfin--response-handlers nil)
        (elfin--ipc-buffer "")
        (elfin--ipc-process 'fake-ipc)
        (elfin-debug nil)
        wire results)
    (cl-letf (((symbol-function 'elfin--ensure-ipc) #'ignore)
              ((symbol-function 'process-send-string)
               (lambda (process string)
                 (should (eq process 'fake-ipc))
                 (should (string-suffix-p "\n" string))
                 (push (json-parse-string string) wire))))
      (elfin--mpv-send '("get_property" "volume")
                       (lambda (value) (push (cons 'volume value) results)))
      (elfin--mpv-send '("get_property" "pause")
                       (lambda (value) (push (cons 'pause value) results)))
      (elfin--mpv-send '("set_property" "pause" :false))
      (should (equal (gethash "command" (car wire)) ["set_property" "pause" :false]))
      (should-not (gethash "request_id" (car wire)))
      (let ((pause-id (gethash "request_id" (cadr wire)))
            (volume-id (gethash "request_id" (caddr wire))))
        (should-not (= pause-id volume-id))
        (elfin--ipc-filter nil (format "{\"request_id\":%d,\"data\":false}\n" pause-id))
        (elfin--ipc-filter nil (format "{\"request_id\":%d,\"data\":37}\n" volume-id))
        (should (equal results '((volume . 37) (pause))))
        (should-not elfin--response-handlers)
        (cl-letf (((symbol-function 'warn) #'ignore))
          (elfin--ipc-filter nil (format "{\"request_id\":%d,\"data\":99}\n" volume-id)))
        (should (= (length results) 2))))))

(ert-deftest elfin-mpv-ipc-fragments-and-malformed-lines ()
  ;; Every split point must produce the same events, exactly once.  Include
  ;; malformed data, an unknown observer, and multiple values in one chunk.
  (let ((wire (concat "not json\n"
                      "{\"event\":\"property-change\",\"id\":7,\"data\":false}\n"
                      "{\"event\":\"property-change\",\"id\":99,\"data\":9}\n"
                      "{\"event\":\"property-change\",\"id\":7,\"data\":true}\n"
                      "{\"event\":\"property-change\",\"id\":7,\"data\":null}\n"
                      "{\"event\":\"idle\"}\n")))
    (dotimes (split (1+ (length wire)))
      (let* ((elfin--ipc-buffer "")
             (elfin-debug nil)
             (elfin--property-observers '((7 . "pause")))
             values events
             (elfin--property-callbacks
              (list (list "pause" (lambda (value) (push value values)))))
             (elfin--event-callbacks
              (list (list "idle" (lambda (event) (push (gethash "event" event) events))))))
        (elfin--ipc-filter nil (substring wire 0 split))
        (elfin--ipc-filter nil (substring wire split))
        (should (equal (reverse values) '(nil t nil)))
        (should (equal events '("idle")))
        (elfin--ipc-filter nil "{\"event\":\"idle\"}\n")
        (should (equal events '("idle" "idle")))))))

(ert-deftest elfin-mpv-response-and-position-are-ready-before-start-event ()
  (elfin-test-with-player
    (let* ((elfin--ipc-buffer "")
           (elfin-debug nil)
           (elfin--response-handlers
            (list (cons 8 (lambda (data) (puthash data "track-b" elfin--entry-map)))))
           (elfin--property-observers '((4 . "playlist-playing-pos")))
           (elfin--property-callbacks '(("playlist-playing-pos" elfin--handle-playlist-pos)))
           (elfin--event-callbacks '(("start-file" elfin--handle-start-file)))
           observed
           (elfin-file-start-hook
            (list (lambda (id) (push (list id elfin--queue-pos) observed)))))
      (elfin--ipc-filter
       nil (concat "{\"event\":\"start-file\",\"playlist_entry_id\":42}\n"
                   "{\"event\":\"property-change\",\"id\":4,\"data\":2}\n"
                   "{\"request_id\":8,\"data\":42}\n"))
      (should (equal observed '(("track-b" 2)))))))

(ert-deftest elfin-mpv-observers-share-registration-and-unsubscribe-last ()
  (elfin-test-with-player
    (let ((elfin--property-observers nil)
          (elfin--property-callbacks nil)
          (elfin--observer-counter 0)
          (elfin--ipc-process 'fake-ipc)
          (first (lambda (_) 'first))
          (second (lambda (_) 'second)))
      (cl-letf (((symbol-function 'process-live-p) (lambda (_) t)))
        (elfin--add-property-callback "pause" first)
        (elfin--add-property-callback "pause" second)
        (elfin--add-property-callback "pause" first)
        (should (= (length commands) 1))
        (should (= (length (cdr (assoc "pause" elfin--property-callbacks))) 2))
        (let ((id (nth 1 (caar commands))))
          (should (equal (car (caar commands)) "observe_property"))
          (elfin--remove-property-callback "pause" first)
          (should (= (length commands) 1))
          (elfin--remove-property-callback "pause" second)
          (should (equal (caar commands) (list "unobserve_property" id)))
          (should-not elfin--property-observers)
          (should-not elfin--property-callbacks))))))

(ert-deftest elfin-mpv-event-registration-is-idempotent ()
  (let* ((elfin--event-callbacks nil)
         (elfin--ipc-buffer "")
         (elfin-debug nil)
         events
         (handler (lambda (event) (push (gethash "reason" event) events))))
    (elfin--add-event-handler "end-file" handler)
    (elfin--add-event-handler "end-file" handler)
    (elfin--ipc-filter nil "{\"event\":\"end-file\",\"reason\":\"eof\"}\n")
    (should (equal events '("eof")))))

(ert-deftest elfin-mpv-reconnect-resets-pending-requests-and-observes-properties ()
  (let ((elfin--ipc-process nil)
        (elfin--ipc-buffer "old partial response")
        (elfin--response-handlers '((99 . ignore)))
        (elfin--request-counter 99)
        (elfin--property-observers '((3 . "pause") (4 . "volume")))
        (elfin-debug nil)
        connections sent)
    (cl-letf (((symbol-function 'elfin--ensure-mpv) #'ignore)
              ((symbol-function 'process-live-p) (lambda (p) (eq p 'fake-ipc)))
              ((symbol-function 'make-network-process)
               (lambda (&rest options) (push options connections) 'fake-ipc))
              ((symbol-function 'process-send-string)
               (lambda (_ string) (push (gethash "command" (json-parse-string string)) sent))))
      (elfin--ensure-ipc)
      (should (equal elfin--ipc-buffer ""))
      (should-not elfin--response-handlers)
      (should (equal (reverse sent) '(["observe_property" 3 "pause"]
                                     ["observe_property" 4 "volume"])))
      (elfin--ensure-ipc)
      (should (= (length connections) 1))
      (funcall (plist-get (car connections) :sentinel) 'fake-ipc "closed")
      (should-not elfin--ipc-process)
      (elfin--ensure-ipc)
      (should (= (length connections) 2)))))

(ert-deftest elfin-mpv-start-reuses-live-process-and-kill-cleans-socket ()
  (let* ((directory (make-temp-file "elfin-mpv-" t))
         (elfin--mpv-socket (expand-file-name "socket" directory))
         (elfin--mpv-process nil)
         spawned deleted)
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest options)
                     (push options spawned)
                     (write-region "" nil elfin--mpv-socket nil 'silent)
                     'fake-mpv))
                  ((symbol-function 'process-live-p) (lambda (p) (eq p 'fake-mpv)))
                  ((symbol-function 'delete-process) (lambda (p) (push p deleted)))
                  ((symbol-function 'get-buffer-create) (lambda (&rest _) nil)))
          (elfin--ensure-mpv)
          (elfin--ensure-mpv)
          (should (= (length spawned) 1))
          (should (equal (car (plist-get (car spawned) :command)) "mpv"))
          (elfin-kill)
          (should (equal deleted '(fake-mpv)))
          (should-not elfin--mpv-process)
          (should-not (file-exists-p elfin--mpv-socket)))
      (delete-directory directory t))))

(ert-deftest elfin-mpv-start-timeout-signals-error ()
  (let* ((directory (make-temp-file "elfin-mpv-" t))
         (elfin--mpv-process nil)
         (elfin--mpv-socket (expand-file-name "never-created" directory)))
    (unwind-protect
        (cl-letf (((symbol-function 'make-process) (lambda (&rest _) 'fake-mpv))
                  ((symbol-function 'get-buffer-create) (lambda (&rest _) nil))
                  ((symbol-function 'sleep-for) #'ignore))
          (should (equal (should-error (elfin--ensure-mpv))
                         '(error "Failed to start mpv"))))
      (delete-directory directory t))))

