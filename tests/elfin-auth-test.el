;;; elfin-auth-test.el --- Authentication and persistence -*- lexical-binding: t -*-

(require 'elfin-test-helper)

(ert-deftest elfin-auth-password-login-and-failure ()
  (elfin-test-with-http
    (let ((old elfin--active-session))
      (elfin-authenticate "https://other.invalid/" "Ada" "p\"ass")
      (let* ((request (pop requests))
             (options (nth 2 request))
             (body (json-parse-string (plist-get options :body))))
        (should (eq (car request) 'post))
        (should (equal (nth 1 request) "https://other.invalid/Users/AuthenticateByName"))
        (should (equal (gethash "Username" body) "Ada"))
        (should (equal (gethash "Pw" body) "p\"ass"))
        (should-not (string-match-p "Token=" (cdr (assoc "Authorization" (plist-get options :headers)))))
        (should (equal elfin--active-session old))
        (elfin-test-respond request "{\"AccessToken\":\"new-token\",\"User\":{\"Id\":\"u2\"}}")
        (should (equal elfin--active-session
                       '(:server "https://other.invalid" :user-id "u2"
                         :access-token "new-token" :username "Ada")))
        (should (equal elfin--sessions (list elfin--active-session))))
      (setq old elfin--active-session)
      (elfin-authenticate "https://other.invalid" "Ada" "wrong")
      (elfin-test-respond (pop requests) nil 'unauthorized)
      (should (eq old elfin--active-session))
      (should (= (length elfin--sessions) 1)))))

(ert-deftest elfin-auth-public-users-flow ()
  (elfin-test-with-http
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt names &rest _)
                 (should (equal names '("Ada" "Bea"))) "Bea"))
              ((symbol-function 'read-passwd) (lambda (&rest _) "secret")))
      (elfin-authenticate "https://other.invalid/")
      (let ((request (pop requests)))
        (should (equal (nth 1 request) "https://other.invalid/Users/Public"))
        (elfin-test-respond request "[{\"Name\":\"Ada\"},{\"Name\":\"Bea\"}]"))
      (let ((body (json-parse-string (plist-get (nth 2 (pop requests)) :body))))
        (should (equal (gethash "Username" body) "Bea"))
        (should (equal (gethash "Pw" body) "secret"))))))

(ert-deftest elfin-auth-quick-connect-polls-until-approved ()
  (elfin-test-with-http
    (let ((kill-ring nil) (kill-ring-yank-pointer nil)
          (interprogram-cut-function nil))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "")))
        (elfin-quick-connect "https://other.invalid/")
        (let ((request (pop requests)))
          (should (equal (nth 1 request) "https://other.invalid/QuickConnect/Initiate"))
          (elfin-test-respond request "{\"Secret\":\"s & x\",\"Code\":\"123456\"}"))
        (should (equal (car kill-ring) "123456"))
        (let ((request (pop requests)))
          (should (equal (elfin-test-query request) '(("secret" "s & x"))))
          (elfin-test-respond request "{\"Authenticated\":false}"))
        (should (= (length requests) 1))
        (elfin-test-respond (pop requests) "{\"Authenticated\":true}")
        (let ((request (pop requests)))
          (should (equal (nth 1 request) "https://other.invalid/Users/AuthenticateWithQuickConnect"))
          (should (equal (gethash "Secret" (json-parse-string (plist-get (nth 2 request) :body))) "s & x"))
          (elfin-test-respond request "{\"AccessToken\":\"qc-token\",\"User\":{\"Id\":\"qc-user\",\"Name\":\"Bea\"}}"))
        (should (equal (plist-get elfin--active-session :username) "Bea"))
        (should (equal (plist-get elfin--active-session :access-token) "qc-token"))
        (should (equal (plist-get elfin--active-session :server) "https://other.invalid"))))))

(ert-deftest elfin-auth-session-file-roundtrip-and-permissions ()
  (let* ((directory (make-temp-file "elfin-sessions-" t))
         (elfin-session-file (expand-file-name "nested/sessions" directory))
         (sessions '((:server "https://one.invalid" :username "Ada" :access-token "one")
                     (:server "https://two.invalid" :username "Bea" :access-token "two")))
         (elfin--sessions sessions)
         (elfin--active-session nil))
    (unwind-protect
        (progn
          (elfin-save-sessions)
          (should (= (logand (file-modes elfin-session-file) #o777) #o600))
          (set-file-modes elfin-session-file #o644)
          (elfin-save-sessions)
          (should (= (logand (file-modes elfin-session-file) #o777) #o600))
          (setq elfin--sessions nil)
          (elfin-restore-sessions)
          (should (equal elfin--sessions sessions))
          (should (equal elfin--active-session (car sessions)))
          (cl-letf (((symbol-function 'called-interactively-p) (lambda (&rest _) t))
                    ((symbol-function 'completing-read) (lambda (&rest _) "Bea @ https://two.invalid")))
            (elfin-restore-sessions)
            (should (equal elfin--active-session (cadr sessions)))))
      (delete-directory directory t))))

(ert-deftest elfin-auth-delete-sessions-respects-selection-and-confirmation ()
  (let* ((first '(:server "one" :username "Ada"))
         (second '(:server "two" :username "Bea"))
         (elfin--sessions (list first second))
         (elfin--active-session second)
         (elfin-session-file nil))
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Ada @ one")))
      (elfin-delete-session))
    (should (equal elfin--sessions (list second)))
    (should (eq elfin--active-session second))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
      (elfin-delete-all-sessions nil))
    (should (equal elfin--sessions (list second)))
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Bea @ two")))
      (elfin-delete-session))
    (should-not elfin--active-session)
    (should-not elfin--sessions)
    (should-error (elfin-delete-session) :type 'user-error)
    (should-error (elfin-delete-all-sessions t) :type 'user-error)
    (setq elfin--sessions (list first) elfin--active-session first)
    (elfin-delete-all-sessions t)
    (should-not elfin--sessions)
    (should-not elfin--active-session)))

;;; elfin-auth-test.el ends here
