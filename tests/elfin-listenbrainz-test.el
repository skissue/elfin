;;; elfin-listenbrainz-test.el --- Scrobbling contracts -*- lexical-binding: t -*-

(require 'elfin-test-helper)

(ert-deftest elfin-listenbrainz-payload-metadata-and-null-values ()
  ;; A compiled literal JSON parse may be constant-folded; mutate a fresh map.
  (let* ((track (copy-hash-table
                 (json-parse-string
                  "{\"Name\":\"Track\",\"Artists\":[\"First\",\"Second\"],\"AlbumArtist\":\"Fallback\",\"Album\":\"Release\",\"RunTimeTicks\":1234500000,\"IndexNumber\":7,\"ProviderIds\":{\"MusicBrainzTrack\":\"recording\",\"MusicBrainzAlbum\":\"release\",\"MusicBrainzArtist\":\"artist\"}}")))
         (payload (elfin--listenbrainz-build-payload track 1700000000))
         (metadata (plist-get payload :track_metadata))
         (additional (plist-get metadata :additional_info)))
    (should (= (plist-get payload :listened_at) 1700000000))
    (should (equal (plist-get metadata :artist_name) "First"))
    (should (equal (plist-get metadata :track_name) "Track"))
    (should (equal (plist-get metadata :release_name) "Release"))
    (should (= (plist-get additional :duration_ms) 123450))
    (should (= (plist-get additional :tracknumber) 7))
    (should (equal (plist-get additional :recording_mbid) "recording"))
    (should (equal (plist-get additional :release_mbid) "release"))
    (should (equal (plist-get additional :artist_mbids) ["artist"]))
    (puthash "Artists" [] track)
    (should (equal (plist-get (plist-get (elfin--listenbrainz-build-payload track) :track_metadata)
                              :artist_name) "Fallback")))
  ;; Check actual JSON, not just Lisp nil: optional metadata must be null.
  (let* ((json (json-parse-string
               (json-serialize (elfin--listenbrainz-build-payload (make-hash-table)))))
         (metadata (gethash "track_metadata" json)))
    (dolist (field '("artist_name" "track_name" "release_name"))
      (should (eq (gethash field metadata) :null)))
    (should-not (gethash "listened_at" json))
    (should-not (gethash "duration_ms" (gethash "additional_info" metadata)))))

(ert-deftest elfin-listenbrainz-submit-requires-mode-and-token ()
  (elfin-test-with-http
    (let ((elfin-listenbrainz-mode nil)
          (elfin-listenbrainz-token "token")
          (elfin-listenbrainz-url "https://listenbrainz.invalid"))
      (elfin--listenbrainz-submit "playing_now" '(:track_metadata (:track_name "Track")))
      (should-not requests)
      (setq elfin-listenbrainz-mode t elfin-listenbrainz-token nil)
      (elfin--listenbrainz-submit "playing_now" '(:track_metadata (:track_name "Track")))
      (should-not requests)
      (setq elfin-listenbrainz-token "token")
      (elfin--listenbrainz-submit "playing_now" '(:track_metadata (:track_name "Track")))
      (let* ((request (pop requests))
             (options (nth 2 request))
             (body (json-parse-string (plist-get options :body))))
        (should (eq (car request) 'post))
        (should (equal (nth 1 request) "https://listenbrainz.invalid/1/submit-listens"))
        (should (equal (cdr (assoc "Authorization" (plist-get options :headers))) "Token token"))
        (should (equal (gethash "listen_type" body) "playing_now"))
        (should (= (length (gethash "payload" body)) 1))
        (should (equal (gethash "track_name" (gethash "track_metadata" (aref (gethash "payload" body) 0))) "Track"))))))

(ert-deftest elfin-listenbrainz-threshold-boundaries-and-single-submission ()
  (elfin-test-with-http
    (let ((elfin-listenbrainz-mode t)
          (elfin-listenbrainz-token "token"))
      (dolist (case '((2000000000 100) (10000000000 240) (nil 240)))
        (let ((elfin--listenbrainz-current-track (make-hash-table :test #'equal))
              (elfin--listenbrainz-scrobbled-p nil)
              (elfin--listenbrainz-track-start-time 1700000000))
          (when (car case) (puthash "RunTimeTicks" (car case) elfin--listenbrainz-current-track))
          (setq requests nil)
          (elfin--listenbrainz-check-condition nil)
          (elfin--listenbrainz-check-condition (- (cadr case) 0.01))
          (should-not requests)
          (elfin--listenbrainz-check-condition (cadr case))
          (should (= (length requests) 1))
          (let ((body (json-parse-string (plist-get (nth 2 (car requests)) :body))))
            (should (equal (gethash "listen_type" body) "single"))
            (should (= (gethash "listened_at" (aref (gethash "payload" body) 0)) 1700000000)))
          (elfin--listenbrainz-check-condition (+ (cadr case) 1))
          (should (= (length requests) 1)))))))

(ert-deftest elfin-listenbrainz-mode-hooks-start-scrobble-end-and-disable ()
  (elfin-test-with-http
    (elfin-test-with-player
      (let ((elfin-listenbrainz-mode nil)
            (elfin-listenbrainz-token "token")
            (elfin--listenbrainz-current-track nil)
            (elfin--listenbrainz-track-start-time nil)
            (elfin--listenbrainz-scrobbled-p nil)
            (elfin--property-callbacks nil)
            (elfin--property-observers nil)
            (elfin--observer-counter 0)
            (elfin--ipc-process nil)
            (elfin--ipc-buffer ""))
        (elfin-listenbrainz-mode 1)
        (elfin-listenbrainz-mode 1)
        (run-hook-with-args 'elfin-file-start-hook "track-9")
        (should (= (length requests) 1))
        (let ((request (pop requests)))
          (should (equal (nth 1 request) "https://jellyfin.invalid/Items/track-9"))
          (cl-letf (((symbol-function 'float-time) (lambda (&rest _) 1700000000.75)))
            (elfin-test-respond request "{\"Name\":\"Track\",\"RunTimeTicks\":2000000000}")))
        (should (= elfin--listenbrainz-track-start-time 1700000000))
        (should (equal (gethash "listen_type" (json-parse-string (plist-get (nth 2 (pop requests)) :body))) "playing_now"))
        (let ((id (caar elfin--property-observers)))
          (elfin--ipc-filter nil (format "{\"event\":\"property-change\",\"id\":%d,\"data\":100}\n" id)))
        (should (= (length requests) 1))
        (should elfin--listenbrainz-scrobbled-p)
        (run-hook-with-args 'elfin-file-end-hook "track-9" "eof")
        (should-not elfin--listenbrainz-current-track)
        (should-not elfin--listenbrainz-track-start-time)
        (should-not elfin--listenbrainz-scrobbled-p)
        (elfin-listenbrainz-mode -1)
        (should-not elfin--property-observers)
        (setq requests nil)
        (run-hook-with-args 'elfin-file-start-hook "ignored")
        (should-not requests)))))

